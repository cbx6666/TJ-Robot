# 复制为 local_llm.env 并填入真实 Key（local_llm.env 已被 .gitignore 忽略）
# Bash: scripts/run_full_system.sh 会在启动前自动 source 仓库根目录的 local_llm.env
#
# Windows PowerShell（同一终端内先设环境变量再 launch）:
#   $env:TJ_LLM_API_URL = "https://api.deepseek.com/v1"
#   $env:TJ_LLM_API_KEY = "sk-xxxxxxxx"   # 须为 ASCII，勿用中文占位
#   $env:TJ_LLM_MODEL = "deepseek-chat"
#   ros2 launch robot_bringup task_pipeline.launch.py
#   （llm_api_url 留空时节点会读 TJ_LLM_API_URL；Key 始终从 TJ_LLM_API_KEY 读）

TJ_LLM_API_URL=https://api.deepseek.com/v1
# 须为供应商提供的 ASCII Key（如 sk-...）；勿保留中文占位，否则 HTTP 头无法用 latin-1 编码会报错
TJ_LLM_API_KEY=REPLACE_WITH_YOUR_DEEPSEEK_API_KEY
TJ_LLM_MODEL=deepseek-chat
